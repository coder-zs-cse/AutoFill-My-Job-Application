{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@core": ["./src/core/index.ts"],
      "@design-system": ["./src/design-system/index.ts"],
      "@features/*": ["./src/features/*/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "android"]
}
